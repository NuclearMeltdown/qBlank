# Build output. Everyone builds their own with build.bat, or takes a release.
build/
/qBlank.exe
/qblank_vcam.dll
# Written out of the exe when the camera is installed; the hash is per build.
/qblank_vcam_*.dll
/qblank_vcam.dll.old*
/qblank_probe.exe

# What a build under the old name leaves behind, next to a working copy that has
# already been renamed: the migrator's output, an executable this build renames
# on its first start, the camera DLLs from before the prefix changed.
/CapView.exe
/CapView.exe.old*
/capview_vcam*.dll*

# Settings are per machine and hold device names and paths. Both names, because
# a settings file written under the old one is adopted rather than replaced.
qBlank.json
qBlank.json.bak*
qBlank.log
CapView.json
CapView.json.bak*
CapView.log

# ffmpeg is downloaded from upstream at runtime, never committed: it is ~100 MB
# and the usual Windows builds are GPL.
ffmpeg/

# Visual Studio / editors
.vs/
*.user
*.vcxproj*
CMakeSettings.json
.cache/
compile_commands.json

# Python helper leftovers in tools/
__pycache__/
*.pyc
